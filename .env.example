# Server-only credentials. Never prefix the service key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
ADMIN_EMAIL=admin@vcard.local

# Optional canonical origin for shared links; omit to use the current domain.
VITE_APP_URL=https://vcard-moldova.vercel.app
# Optional fixed origin for CSRF checks; omit for local and Vercel previews.
# APP_ORIGIN=https://vcard-moldova.vercel.app
# PORT=3001
