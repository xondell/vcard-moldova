# Public app origin used in QR destinations and canonical URLs
VITE_APP_URL=https://your-vcard-domain.example

# Supabase browser client (future production integration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
